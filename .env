# ────────────────────────────────────────
# 栖迟 · 环境变量模板
# 复制本文件为 .env.local，填入真实 key 后开始使用
# ────────────────────────────────────────

# ─── OpenAI ─────────────────────────────
OPENAI_API_KEY=sk-DwHJaPf12jbdkNW9lrpOThA8syeAhM0OmrSHMKqPKaond3Ym

# 主力模型（P1 共情翻译 + P5 月度总结）
OPENAI_MODEL_MAIN=gpt-3.5-turbo

# 快速模型（P2 情绪标签 + P3 NER 抽取，并行调用）
OPENAI_MODEL_FAST=gpt-3.5-turbo

# 可选：使用 OpenAI 兼容代理（Azure / OpenRouter / 自建网关 / 国内中转）
# 留空则走 OpenAI 官方 https://api.openai.com/v1
OPENAI_BASE_URL=https://api.chatanywhere.tech/v1

# ─── 应用配置 ───────────────────────────
NEXT_PUBLIC_APP_NAME=栖迟
NEXT_PUBLIC_APP_VERSION=0.1.0

# 限流（每分钟最多调用主力模型次数，防止意外烧钱）
LLM_RATE_LIMIT_PER_MIN=10

# 调试模式（开启会在浏览器 console 输出 LLM 调用日志）
NEXT_PUBLIC_DEBUG_LLM=false
